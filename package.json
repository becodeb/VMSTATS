{
  "name": "vmstats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Observabilidad de VM: metricas de host, contenedores y despliegues de Coolify",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vmstats/web",
    "dev:collector": "npm run dev --workspace=@vmstats/collector",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty && npm run typecheck --workspace=@vmstats/web",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "npm run generate --workspace=@vmstats/db",
    "db:migrate": "npm run migrate --workspace=@vmstats/db",
    "bootstrap:admin": "npm run bootstrap:admin --workspace=@vmstats/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
