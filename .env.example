# =============================================================================
# vmstats — configuración.
#
# Copiar a `.env` y completar. Este archivo NO lleva secretos reales: es la
# plantilla que se versiona.
#
# En Coolify, estas mismas variables se cargan en el panel de Environment
# Variables del recurso; no hace falta subir un `.env` al servidor.
# =============================================================================

# --- Obligatorias ------------------------------------------------------------

# Contraseña de PostgreSQL. La base no publica puertos, pero igual: generala,
# no la inventes.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Clave con la que se firman los tokens CSRF. Mínimo 32 caracteres.
# Cambiarla invalida los CSRF en vuelo (el usuario reintenta y listo), NO las
# sesiones: las sesiones viven en la base.
#   openssl rand -base64 48
SESSION_SECRET=

# --- Recomendadas ------------------------------------------------------------

# Origen público desde el que se sirve la consola. Se usa para validar la
# cabecera `Origin` en las mutaciones. Sin esto se compara contra el host del
# propio pedido, que detrás de un proxy puede no ser el que ve el navegador.
#   Ejemplo: https://vmstats.midominio.com
#
# Admite varios separados por coma, para cuando la consola está accesible por
# dos nombres a la vez —una migración de dominio, o un nombre provisorio
# mientras se propaga el DNS—. Con uno solo configurado, entrar por el otro
# devuelve «El origen del pedido no coincide» y no se puede iniciar sesión.
#   Ejemplo: https://vmstats.midominio.com,https://vmstats.1.2.3.4.sslip.io
PUBLIC_ORIGIN=

# Puerto en el que Coolify (o el host) publica la consola.
VMSTATS_PUERTO=4321

# --- Coolify (opcional) ------------------------------------------------------
#
# Sin estas dos, la sección Despliegues queda vacía y lo explica. No rompe nada.
#
# El token tiene que ser de sólo lectura: alcanza con el permiso `read`.
# NO le des `read:sensitive` salvo que sepas por qué — vmstats no lo necesita,
# y ese permiso hace que la API devuelva secretos de las aplicaciones en claro.
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=

# --- Logs de contenedor (opcional) -------------------------------------------
#
# Habilita la API interna por la que `web` le pide logs al collector. Sin este
# token el servidor interno no arranca y el botón de logs explica que la
# función no está configurada.
#
# Mínimo 32 caracteres. Es un secreto compartido entre los dos contenedores y
# nunca sale de la red interna de Docker.
#   openssl rand -base64 48
COLLECTOR_TOKEN_INTERNO=

# --- Ajustes finos (opcionales) ----------------------------------------------

# Cada cuánto el collector toma una muestra en memoria.
COLLECTOR_INTERVALO_MUESTRA_MS=5000

# Cada cuánto la escribe a la base. Múltiplo del anterior.
COLLECTOR_INTERVALO_PERSISTENCIA_MS=10000

# Identidad del host en la base.
#
# Por defecto se deduce del machine-id de la VM, que sobrevive a reinicios. Se
# fija a mano cuando la VM se reconstruye desde cero y se quiere conservar el
# historial anterior: mismo id, mismas series.
# VMSTATS_HOST_ID=

# Usuario y base de PostgreSQL, si querés cambiarlos.
POSTGRES_USER=vmstats
POSTGRES_DB=vmstats

# --- Primer administrador (de un solo uso) -----------------------------------
#
# vmstats NO crea credenciales por defecto. Hay dos formas de crear el primer
# usuario; ésta es la no interactiva:
#
#   1. Descomentá y completá estas dos variables.
#   2. docker compose exec web node packages/db/dist/bootstrap.js
#   3. BORRALAS de nuevo y redesplegá.
#
# La alternativa interactiva no deja rastro en el entorno:
#
#   docker compose exec -it web node packages/db/dist/bootstrap.js
#
# VMSTATS_ADMIN_EMAIL=
# VMSTATS_ADMIN_PASSWORD=
# VMSTATS_ADMIN_NOMBRE=Administrador
